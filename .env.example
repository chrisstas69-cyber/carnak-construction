# Public canonical URL (no trailing slash). Used for canonical tags, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Bid form email delivery via Resend (https://resend.com). Leave blank to run the form in preview mode.
RESEND_API_KEY=
# Inbox that receives bid requests.
BID_INBOX_EMAIL=
# Verified sender on your Resend domain, e.g. "Carnak Website <bids@your-domain.com>"
BID_FROM_EMAIL=
